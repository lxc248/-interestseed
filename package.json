{
  "name": "interestseed",
  "version": "3.7.0",
  "description": "An interest validator for Obsidian: turn one saved post into a real 3-day action, then let evidence decide whether to keep it.",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "manifest.json"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check:site": "node scripts/check-site.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:cli": "node scripts/check-cli-version.mjs",
    "check:package-digest": "node scripts/check-package-digest.mjs",
    "check:main-size": "node scripts/check-main-size.mjs",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run typecheck:standalone && npm run test && npm run lint && npm run check:main-size && npm run check:site && npm run check:docs && npm run check:version && npm run check:size && npm run audit && npm run build && npm run build:standalone && npm run check:cli",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "build:standalone": "vite build --config standalone/vite.config.ts",
    "standalone": "node standalone/dist/cli.js",
    "typecheck:standalone": "tsc -p standalone/tsconfig.json",
    "verify:standalone": "npm run typecheck:standalone && npm run build:standalone",
    "package:standalone": "node scripts/package-standalone.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "interest-validation",
    "interest-graph",
    "local-first",
    "knowledge-management",
    "mcp",
    "typescript"
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sigstore/bundle": "^5.0.1",
    "@sigstore/tuf": "^5.0.1",
    "@sigstore/verify": "^4.1.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "author": "aicoder"
}
