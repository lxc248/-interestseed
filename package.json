{
  "name": "interestseed",
  "version": "3.7.0",
  "description": "An interest validator for Obsidian: turn one saved post into a real 3-day action, then let evidence decide whether to keep it.",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "manifest.json"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check:site": "node scripts/check-site.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:version": "node scripts/check-version.mjs",
    "verify": "npm run typecheck && npm run test && npm run lint && npm run check:site && npm run check:docs && npm run check:version && npm run build",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "build:standalone": "vite build --config standalone/vite.config.ts",
    "standalone": "node standalone/dist/cli.js",
    "typecheck:standalone": "tsc -p standalone/tsconfig.json",
    "verify:standalone": "npm run typecheck:standalone && npm run build:standalone",
    "package:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-standalone.ps1"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "interest-validation",
    "interest-graph",
    "local-first",
    "knowledge-management",
    "mcp",
    "typescript"
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "author": "aicoder"
}
