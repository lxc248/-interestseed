{
  "name": "interestseed",
  "version": "2.7.15",
  "description": "An interest validator for Obsidian: turn one saved post into a real 3-day action, then let evidence decide whether to keep it.",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "manifest.json"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run test && npm run lint && npm run build",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "interest-validation",
    "interest-graph",
    "local-first",
    "knowledge-management",
    "mcp",
    "typescript"
  ],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "author": "InterestSeed"
}
